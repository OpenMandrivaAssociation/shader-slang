 # cmark-gfm (CommonMark / GFM Markdown parser, swiftlang fork)
-set(CMARK_LIB_FUZZER OFF)
-set(CMARK_FUZZ_QUADRATIC OFF)
-set(_prev_BUILD_TESTING ${BUILD_TESTING})
-set(_prev_BUILD_SHARED_LIBS ${BUILD_SHARED_LIBS})
-set(BUILD_TESTING OFF)
-set(BUILD_SHARED_LIBS OFF)
-if(NOT SLANG_OVERRIDE_CMARK_PATH)
-    add_subdirectory(cmark EXCLUDE_FROM_ALL ${system})
-else()
-    add_subdirectory(
-        ${SLANG_OVERRIDE_CMARK_PATH}/cmark
-        cmark
-        EXCLUDE_FROM_ALL
-        ${system}
+if(SLANG_USE_SYSTEM_CMARK)
+    find_package(PkgConfig REQUIRED)
+    pkg_check_modules(CMARK_GFM REQUIRED libcmark-gfm)
+    find_library(
+        CMARK_GFM_LIBRARY
+        NAMES cmark-gfm
+        PATHS ${CMARK_GFM_LIBRARY_DIRS}
+        REQUIRED
     )
+    # An imported target named libcmark-gfm is linked as -llibcmark-gfm.
+    # Pass the absolute library path through instead.
+    set(SLANG_CMARK_LIBRARY "${CMARK_GFM_LIBRARY}" PARENT_SCOPE)
+else()
+    set(CMARK_LIB_FUZZER OFF)
+    set(CMARK_FUZZ_QUADRATIC OFF)
+    set(_prev_BUILD_TESTING ${BUILD_TESTING})
+    set(_prev_BUILD_SHARED_LIBS ${BUILD_SHARED_LIBS})
+    set(BUILD_TESTING OFF)
+    set(BUILD_SHARED_LIBS OFF)
+    if(NOT SLANG_OVERRIDE_CMARK_PATH)
+        add_subdirectory(cmark EXCLUDE_FROM_ALL ${system})
+    else()
+        add_subdirectory(
+            ${SLANG_OVERRIDE_CMARK_PATH}/cmark
+            cmark
+            EXCLUDE_FROM_ALL
+            ${system}
+        )
+    endif()
+    set(BUILD_TESTING ${_prev_BUILD_TESTING})
+    set(BUILD_SHARED_LIBS ${_prev_BUILD_SHARED_LIBS})
+    set(SLANG_CMARK_LIBRARY libcmark-gfm PARENT_SCOPE)
 endif()
-set(BUILD_TESTING ${_prev_BUILD_TESTING})
